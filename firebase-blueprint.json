{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and synchronization metadata.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique identifier of the authenticated user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "User avatar photo URL"
        },
        "lastSyncedAt": {
          "type": "number",
          "description": "Timestamp of the last successful cloud sync"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp of profile creation"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp of profile update"
        }
      },
      "required": ["userId", "createdAt", "updatedAt"]
    },
    "UserFinanceData": {
      "title": "User Financial Store",
      "description": "Consolidated financial data store containing transactions, accounts, cards, budgets, and settings.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "accounts": {
          "type": "array",
          "description": "List of bank accounts and wallets"
        },
        "creditCards": {
          "type": "array",
          "description": "List of credit cards"
        },
        "categories": {
          "type": "array",
          "description": "List of categories"
        },
        "paymentApps": {
          "type": "array",
          "description": "List of configured payment apps"
        },
        "transactions": {
          "type": "array",
          "description": "Ledger of transactions"
        },
        "recurring": {
          "type": "array",
          "description": "Recurring transaction rules"
        },
        "subscriptions": {
          "type": "array",
          "description": "Active and past subscriptions"
        },
        "budgets": {
          "type": "array",
          "description": "Monthly category budgets"
        },
        "goals": {
          "type": "array",
          "description": "Savings and debt payoff goals"
        },
        "loans": {
          "type": "array",
          "description": "Loans and EMIs"
        },
        "investments": {
          "type": "array",
          "description": "Investment portfolio items"
        },
        "debts": {
          "type": "array",
          "description": "Lent and borrowed debt records"
        },
        "reconciliations": {
          "type": "array",
          "description": "Account reconciliations"
        },
        "settings": {
          "type": "object",
          "description": "Application settings and preferences"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp when this record was updated"
        }
      },
      "required": ["userId", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile and authentication synchronization records."
    },
    "/users/{userId}/finance/{docId}": {
      "schema": "UserFinanceData",
      "description": "Stores persistent financial transactions, accounts, categories, and settings per user."
    }
  }
}
